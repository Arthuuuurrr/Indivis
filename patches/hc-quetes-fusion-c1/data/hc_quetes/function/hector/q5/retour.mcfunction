# Le filet qui debloque les joueurs DEJA coinces. Un joueur a signale que la remise etait
# impossible : il etait a l etape 6 avec la scene entiere, le « ? » au-dessus d Hector et le bouton
# affiche, mais l insigne n etait jamais entre dans son sac — l etape avancait avant le don (racine
# corrigee dans prend_insigne). Pour celui-la, corriger la racine ne suffit pas : il est deja a 6.
# Hector le lui redonne ici, en silence. Pas de « return run » : la scene doit continuer.
execute unless items entity @s container.* *[custom_data~{hc_quete:"sqvccr02_insigne"}] run function hc_quetes:objets/q5_insigne
function hc_quetes:lib/dire {pnj:"Hector Valmont",t:"Donne. … Jour 1 à 8, signal levé chaque soir, rien à signaler. Jour 9, plus de sel. Jour 11, Lauzac se présente avec des hommes de mer et dit venir relever le poste. Il n'a pas de scellé. Bréhal n'ouvre pas. … Il n'a pas ouvert, soldat. Brave garçon. Et ils sont entrés quand même, par les perches, pendant qu'il tenait la porte."}
function hc_quetes:lib/dire {pnj:"Hector Valmont",t:"Un quartier-maître qui se présente sans scellé n'est plus un quartier-maître, c'est un homme devant une porte. Bréhal le savait par cœur, je le lui ai assez répété. Ça l'a tué et il a eu raison. Les deux à la fois. C'est comme ça que ça marche, et personne ne te le dit en t'engageant."}
execute if score @s hcq_sqvccr02_o1 matches 1 run function hc_quetes:lib/dire {pnj:"Hector Valmont",t:"Corvin tenait la tour, tu dis. Maître d'armes. Je l'ai formé lui aussi, avant Bréhal : des bras, pas de tête, et une rancune bien rangée. Il portait le tabard à l'envers ? Alors il savait exactement ce qu'il faisait. Un homme qui déserte cache sa couleur ; un homme qui la retourne veut qu'on la voie retournée."}
function hc_quetes:lib/dire {pnj:"Hector Valmont",t:"Et la note. « Dites à Valmont que ce n'est pas sa faute. » … Vingt ans, ce gamin. Il écrivait mal et il jugeait bien. Il a trouvé le temps d'écrire ça en marchant vers un trou, pour un vieux assis sur un banc. Range-la. Non — garde-la, toi. Moi je la connais déjà par cœur et je n'en ai pas besoin sous les yeux."}
function hc_quetes:lib/dire {pnj:"Hector Valmont",t:"« Ils nous emmènent aux Fosses. » Les Fosses de Carrec, alors. Une carrière des Anciens, au fond de la Verdaine. De la pierre noire, des galeries, des stèles gravées dont personne ici ne sait lire un mot — demande à Kerrec, aux archives, c'est son domaine. Ce que je sais, moi, c'est que plus personne n'y creuse depuis cent ans. Sauf des prisonniers."}
function hc_quetes:lib/dire {pnj:"Hector Valmont",t:"Tu vas y aller. Pas ce soir. Tu as marché toute la journée avec une flèche dans la cuisse, ça se voit à la façon dont tu poses le pied, et j'ai vu assez de gens se vider pour un point de couture négligé. Mange, dors, fais-toi recoudre."}
function hc_quetes:lib/dire {pnj:"Hector Valmont",t:"Ces jambières ont porté un sergent qui savait attendre le bon moment ; c'est tout le métier, et c'est la seule chose que je peux encore te transmettre. Prends-les."}
function hc_quetes:lib/choix {n:1,v:114,c:"green",t:"Prendre les jambières.",h:"Terminer la quête"}
