function capitale:dialogue/random/roll_3_self
execute if score @s CAP_DLG_RNG matches 1 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Messire, les Profondeurs reçoivent les grands noms avec plus de prudence que d’empressement ; votre nom a déjà circulé ici sans toujours laisser d’amertume. Dites ce qui vous amène, sans détour ; je préfère les raisons nettes.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 2 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Messire, les Profondeurs reçoivent les grands noms avec plus de prudence que d’empressement ; votre nom a déjà circulé ici sans toujours laisser d’amertume. Dites ce qui vous amène, sans détour ; je préfère les raisons nettes ; dites l’essentiel.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 3 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Messire, les Profondeurs reçoivent les grands noms avec plus de prudence que d’empressement ; votre nom a déjà circulé ici sans toujours laisser d’amertume. Dites ce qui vous amène, sans détour ; la garde veut des paroles nettes.","color":"white"}]
