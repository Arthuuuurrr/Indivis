function capitale:dialogue/random/roll_3_self
execute if score @s CAP_DLG_RNG matches 1 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Agent de la Couronne, votre mandat sera entendu, mais jamais cru sur parole ; quelques gestes passés jouent malgré tout en votre faveur. Dites ce qui vous amène, sans détour ; je préfère les raisons nettes.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 2 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Agent de la Couronne, votre mandat sera entendu, mais jamais cru sur parole ; certains gestes passés jouent malgré tout en votre faveur. Dites ce qui vous amène, sans détour ; je préfère les raisons nettes.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 3 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Agent de la Couronne, votre mandat sera entendu, mais jamais cru sur parole ; quelques gestes passés jouent malgré tout en votre faveur. Dites ce qui vous amène, sans détour ; la garde veut des paroles nettes.","color":"white"}]
