execute if score @s CAP_DLG_RNG matches 2 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Citoyen, ceux d’en bas reconnaissent plus vite les pas qui ressemblent aux leurs ; certains gestes passés jouent déjà en votre faveur. Dites ce qui vous amène, sans détour ; je préfère les raisons nettes.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 3 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Citoyen, ceux d’en bas reconnaissent plus vite les pas qui ressemblent aux leurs ; quelques gestes passés jouent déjà en votre faveur. Dites ce qui vous amène, sans détour ; la garde veut des paroles nettes.","color":"white"}]
