function capitale:dialogue/random/roll_3_self
execute if score @s CAP_DLG_RNG matches 1 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Étranger, ces rues ne vous doivent rien, mais elles laissent passer qui vient sans arrogance ; quelques gestes passés jouent déjà en votre faveur. Dites ce qui vous amène, sans détour ; je préfère les raisons nettes.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 2 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Étranger, ces rues ne vous doivent rien, mais elles laissent passer qui vient sans arrogance ; certains gestes passés jouent déjà en votre faveur. Dites ce qui vous amène, sans détour ; je préfère les raisons nettes.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 3 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Étranger, ces rues ne vous doivent rien, mais elles laissent passer qui vient sans arrogance ; quelques gestes passés jouent déjà en votre faveur. Dites ce qui vous amène, sans détour ; la garde veut des paroles nettes.","color":"white"}]
