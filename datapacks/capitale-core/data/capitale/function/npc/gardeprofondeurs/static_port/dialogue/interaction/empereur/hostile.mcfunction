function capitale:dialogue/random/roll_3_self
execute if score @s CAP_DLG_RNG matches 1 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Majesté, même sous les hauteurs, nul ne prétend ignorer votre présence ; votre réputation donne aux ruelles une raison de se fermer davantage. Dites ce qui vous amène ; les Profondeurs écoutent sans se livrer tout entières.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 2 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Majesté, même sous les hauteurs, nul ne prétend ignorer votre présence ; votre réputation donne aux ruelles une raison de se fermer davantage. Dites ce qui vous amène ; les Profondeurs écoutent sans se livrer tout entières ; dites l’essentiel.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 3 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Majesté, même sous les hauteurs, nul ne prétend ignorer votre présence ; votre réputation donne aux ruelles une raison de se fermer davantage. Dites ce qui vous amène ; la garde veut des paroles nettes.","color":"white"}]
