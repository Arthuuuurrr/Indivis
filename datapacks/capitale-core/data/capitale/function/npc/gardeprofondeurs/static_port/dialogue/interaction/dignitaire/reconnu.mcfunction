function capitale:dialogue/random/roll_3_self
execute if score @s CAP_DLG_RNG matches 1 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Haut dignitaire, votre titre descend rarement jusqu’ici sans éveiller l’attention ; votre nom a déjà circulé ici sans toujours laisser d’amertume. Dites ce qui vous amène ; ici, les détours convainquent peu.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 2 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Haut dignitaire, votre titre descend rarement jusqu’ici sans éveiller l’attention ; votre nom a déjà circulé ici sans toujours laisser d’amertume. Dites ce qui vous amène ; ici, les détours convainquent peu ; dites l’essentiel.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 3 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Haut dignitaire, votre titre descend rarement jusqu’ici sans éveiller l’attention ; votre nom a déjà circulé ici sans toujours laisser d’amertume. Dites ce qui vous amène ; la garde veut des paroles nettes.","color":"white"}]
