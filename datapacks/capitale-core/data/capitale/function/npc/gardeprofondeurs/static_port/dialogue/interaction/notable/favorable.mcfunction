execute if score @s CAP_DLG_RNG matches 2 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Notable, ici les titres impressionnent moins que la façon de traiter les habitants ; certains gestes passés jouent malgré tout en votre faveur. Dites ce qui vous amène, sans détour ; je préfère les raisons nettes.","color":"white"}]
execute if score @s CAP_DLG_RNG matches 3 run tellraw @s [{"text":"[Garde des Profondeurs]","color":"#FF8C00"},{"text":" : Notable, ici les titres impressionnent moins que la façon de traiter les habitants ; quelques gestes passés jouent malgré tout en votre faveur. Dites ce qui vous amène, sans détour ; la garde veut des paroles nettes.","color":"white"}]
