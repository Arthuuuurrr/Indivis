function capitale:quest/journalieres/cooldown/sync_self
function capitale:player/ensure_runtime_self
scoreboard players add @s CAP_CD_GLOBE 0
execute if score @s QUEST_DIVERS_LAMPE matches 30.. run scoreboard players set @s QUEST_DIVERS_LAMPE 0
execute if score @s QUEST_DIVERS_LAMPE matches 0 unless score @s CAP_CD_GLOBE matches 1.. if score @s NPC_NEAR_CD matches 0 run function capitale:dialogue/random/roll_3_self
execute if score @s QUEST_DIVERS_LAMPE matches 0 unless score @s CAP_CD_GLOBE matches 1.. if score @s NPC_NEAR_CD matches 0 if score @s CAP_DLG_RNG matches 1 run function capitale:dialogue/sound/parole_quete_self
execute if score @s QUEST_DIVERS_LAMPE matches 0 unless score @s CAP_CD_GLOBE matches 1.. if score @s NPC_NEAR_CD matches 0 if score @s CAP_DLG_RNG matches 1 run tellraw @s [{"text": "[Veilleuse des Profondeurs]", "color": "yellow"}, {"text": " Les lanternes du Globe pâlissent et se désaccordent. Si vous avez la main sûre, venez me parler.", "color": "white"}]
execute if score @s QUEST_DIVERS_LAMPE matches 0 unless score @s CAP_CD_GLOBE matches 1.. if score @s NPC_NEAR_CD matches 0 if score @s CAP_DLG_RNG matches 2 run function capitale:dialogue/sound/parole_quete_self
execute if score @s QUEST_DIVERS_LAMPE matches 0 unless score @s CAP_CD_GLOBE matches 1.. if score @s NPC_NEAR_CD matches 0 if score @s CAP_DLG_RNG matches 2 run tellraw @s [{"text": "[Veilleuse des Profondeurs]", "color": "yellow"}, {"text": " Le socle du Globe répond mal depuis ce matin. Ceux d’en haut disent que ce ne sont que des lampes ; ils ne vivent pas sous les anneaux.", "color": "white"}]
execute if score @s QUEST_DIVERS_LAMPE matches 0 unless score @s CAP_CD_GLOBE matches 1.. if score @s NPC_NEAR_CD matches 0 if score @s CAP_DLG_RNG matches 3 run function capitale:dialogue/sound/parole_quete_self
execute if score @s QUEST_DIVERS_LAMPE matches 0 unless score @s CAP_CD_GLOBE matches 1.. if score @s NPC_NEAR_CD matches 0 if score @s CAP_DLG_RNG matches 3 run tellraw @s [{"text": "[Veilleuse des Profondeurs]", "color": "yellow"}, {"text": " Une lumière qui tremble suffit à perdre un novice. Approchez si vous savez écouter la pierre avant de la toucher.", "color": "white"}]
execute if score @s QUEST_DIVERS_LAMPE matches 0 if score @s CAP_CD_GLOBE matches 1.. if score @s NPC_NEAR_CD matches 0 run function capitale:dialogue/sound/parole_quete_self
execute if score @s QUEST_DIVERS_LAMPE matches 0 if score @s CAP_CD_GLOBE matches 1.. if score @s NPC_NEAR_CD matches 0 run tellraw @s [{"text":"[Veilleuse des Profondeurs]","color":"yellow"},{"text":" : Le Globe tient mieux depuis votre passage. Revenez après la prochaine rotation des lanternes.","color":"white"}]
execute if score @s QUEST_DIVERS_LAMPE matches 0 if score @s NPC_NEAR_CD matches 0 run scoreboard players set @s NPC_NEAR_CD 120
